@model Be_25dh110275_NguyenHoangAnh.Models.Order

@{
    ViewBag.Title = "Xóa đơn hàng";
    Layout = "~/Areas/admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 border-danger">
        <div class="card-header bg-danger text-white fw-bold">
            <h4>XÁC NHẬN XÓA ĐƠN HÀNG </h4>
        </div>
        <div class="card-body">
            <h5 class="text-danger mb-3">Bạn có chắc chắn muốn xóa đơn hàng này không? Hành động này không thể hoàn tác!</h5>

            <dl class="row">
                <dt class="col-sm-4">Mã đơn hàng:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.OrderID</dd>

                <dt class="col-sm-4">Ngày đặt:</dt>
                <dd class="col-sm-8">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Tổng tiền:</dt>
                <dd class="col-sm-8 text-danger fw-bold">@string.Format("{0:N0} đ", Model.TotalAmount)</dd>

                <dt class="col-sm-4">Địa chỉ giao:</dt>
                <dd class="col-sm-8">@Model.AddressDelivery</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Index", "Orders", new { area = "admin" })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="fas fa-trash me-1"></i> Xóa vĩnh viễn
                    </button>
                </div>
            }
        </div>
    </div>
</div>