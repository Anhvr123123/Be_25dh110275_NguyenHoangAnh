@model Be_25dh110275_NguyenHoangAnh.Models.Customer

@{
    ViewBag.Title = "Thêm mới khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-title-admin {
        background-color: #1E8A54 !important;
        color: #000000 !important;
        padding: 10px 15px;
        font-weight: bold;
        font-size: 22px;
        width: 100%;
        margin-bottom: 20px;
        box-sizing: border-box;
    }
</style>

<div class="page-title-admin">
    THÊM MỚI KHÁCH HÀNG
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.Label("Họ tên khách hàng", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.Label("Email", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.Label("Số điện thoại", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.Label("Địa chỉ", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.Label("Tên đăng nhập", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.Label("Mật khẩu", htmlAttributes: new { @class = "form-label fw-bold" })
            @Html.Password("Password", "", new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <input type="submit" value="Thêm mới" class="btn btn-primary" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}