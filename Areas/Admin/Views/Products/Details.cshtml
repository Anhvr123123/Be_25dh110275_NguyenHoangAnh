
@model Be_25dh110275_NguyenHoangAnh.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string image = Model.ProductImage ?? "";
    string imageUrl = "";

    if (image.StartsWith("http://") ||
        image.StartsWith("https://"))
    {
        imageUrl = image;
    }
    else if (!string.IsNullOrWhiteSpace(image))
    {
        imageUrl = Url.Content("~/Content/images/" + image);
    }
}

<style>
    .detail-container {
        max-width: 1000px;
        margin: 40px auto;
    }

    .detail-header {
        background: #198754;
        color: white;
        padding: 18px;
        font-size: 24px;
        font-weight: bold;
        border-radius: 6px;
        margin-bottom: 25px;
    }

    .detail-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.1);
    }

    .product-image {
        width: 100%;
        height: 320px;
        object-fit: contain;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
    }

    .product-name {
        font-size: 26px;
        font-weight: bold;
        color: #222;
        margin-bottom: 20px;
    }

    .product-price {
        color: #dc3545;
        font-size: 26px;
        font-weight: bold;
    }

    .detail-info {
        padding: 14px 0;
        border-bottom: 1px solid #eee;
    }

    .detail-buttons {
        display: flex;
        gap: 12px;
        margin-top: 25px;
        flex-wrap: wrap;
    }

        .detail-buttons .btn {
            padding: 10px 20px;
        }
</style>

<div class="detail-container">

    <div class="detail-header">
        <i class="fas fa-box-open"></i>
        CHI TIẾT SẢN PHẨM
    </div>

    <div class="detail-card">

        <div class="row">

            <div class="col-md-5 mb-4">

                @if (!string.IsNullOrEmpty(imageUrl))
                {
                    <img src="@imageUrl"
                         alt="@Model.ProductName"
                         class="product-image" />
                }
                else
                {
                    <div class="text-center p-5 bg-light">
                        Chưa có hình ảnh
                    </div>
                }

            </div>

            <div class="col-md-7">

                <h2 class="product-name">
                    @Model.ProductName
                </h2>

                <div class="detail-info">
                    <strong>Mã sản phẩm:</strong>
                    @Model.ProductID
                </div>

                <div class="detail-info">
                    <strong>Tên sản phẩm:</strong>
                    @Model.ProductName
                </div>

                <div class="detail-info">
                    <strong>Giá bán:</strong>

                    <div class="product-price">
                        @string.Format("{0:N0} đ", Model.ProductPrice)
                    </div>
                </div>

                <div class="detail-buttons">

                    <a href="@Url.Action("Edit", "Products",
                        new {
                            area = "Admin",
                            id = Model.ProductID
                        })"
                       class="btn btn-primary">

                        <i class="fas fa-edit"></i>
                        Chỉnh sửa

                    </a>

                    <a href="@Url.Action("Index", "Products",
                        new { area = "Admin" })"
                       class="btn btn-secondary">

                        <i class="fas fa-arrow-left"></i>
                        Quay lại

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
