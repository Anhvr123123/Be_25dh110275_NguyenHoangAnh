
@model Be_25dh110275_NguyenHoangAnh.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link href="@Url.Content("~/Content/myStyle/AdminProductForm.css")"
      rel="stylesheet" />

<div class="product-form-container">

    <div class="product-form-title">
        <i class="fas fa-plus-circle"></i>
        THÊM SẢN PHẨM MỚI
    </div>

    <div class="product-form-card">

        @using (Html.BeginForm(
            "Create",
            "Products",
            new { area = "Admin" },
            FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                     true, "",
                     new { @class = "text-danger" })

            @Html.Partial("PVCreateEditProduct", Model)

            <div class="product-form-actions">

                <button type="submit"
                        class="product-btn-save">
                    <i class="fas fa-plus"></i>
                    THÊM SẢN PHẨM
                </button>

                <a href="@Url.Action("Index", "Products",
                    new { area = "Admin" })"
                   class="product-btn-back">
                    <i class="fas fa-arrow-left"></i>
                    Quay lại danh sách
                </a>

            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
