
@{
    ViewBag.Title = "Trang quản trị hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .home-admin {
        max-width: 1100px;
        margin: 65px auto 40px;
        font-family: Arial, sans-serif;
    }

    .home-title {
        background: #218b58;
        padding: 16px 20px;
        color: black;
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 22px;
    }

    .home-welcome {
        background: #f8f9fc;
        border-left: 5px solid #218b58;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

        .home-welcome h3 {
            margin: 0 0 12px;
            font-size: 22px;
            font-weight: bold;
        }

        .home-welcome p {
            color: #777;
            font-size: 15px;
            line-height: 1.7;
        }

    .home-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .home-card {
        background: white;
        border: 1px solid #ddd;
        border-left: 5px solid #218b58;
        border-radius: 5px;
        padding: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .home-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 60px;
    }

    .home-card-label {
        color: #218b58;
        font-size: 15px;
        line-height: 1.5;
    }

    .home-card-icon {
        font-size: 32px;
        color: #218b58;
    }

    .home-card h3 {
        font-size: 20px;
        font-weight: bold;
        margin: 12px 0 20px;
    }

    .home-btn {
        display: inline-block;
        background: #218b58;
        color: white;
        border-radius: 4px;
        padding: 9px 12px;
        text-decoration: none;
        font-size: 14px;
    }

        .home-btn:hover {
            background: #176b42;
            color: white;
            text-decoration: none;
        }

    @@media (max-width: 768px) {
        .home-grid {
            grid-template-columns: 1fr;
        }

        .home-admin {
            margin: 25px auto;
        }
    }
</style>

<div class="home-admin">

    <div class="home-title">
        TRANG QUẢN TRỊ HỆ THỐNG
    </div>

    <div class="home-welcome">
        <h3>Xin chào, Quản trị viên!</h3>

        <p>
            Chào mừng bạn trở lại với hệ thống quản lý My Store.
            Dưới đây là tóm tắt nhanh tình hình hoạt động
            của website.
        </p>
    </div>

    <div class="home-grid">

        <div class="home-card">
            <div class="home-card-header">
                <span class="home-card-label">
                    QUẢN LÝ<br />KHÁCH HÀNG
                </span>
                <i class="fas fa-users home-card-icon"></i>
            </div>

            <h3>Khách hàng</h3>

            <a class="home-btn"
               href="@Url.Action("Index", "Customers", new { area = "Admin" })">
                Quản lý khách hàng
            </a>
        </div>

        <div class="home-card">
            <div class="home-card-header">
                <span class="home-card-label">
                    QUẢN LÝ DANH MỤC
                </span>
                <i class="fas fa-list home-card-icon"></i>
            </div>

            <h3>Danh mục</h3>

            <a class="home-btn"
               href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                Quản lý danh mục
            </a>
        </div>

        <div class="home-card">
            <div class="home-card-header">
                <span class="home-card-label">
                    QUẢN LÝ SẢN PHẨM
                </span>
                <i class="fas fa-box home-card-icon"></i>
            </div>

            <h3>Sản phẩm</h3>

            <a class="home-btn"
               href="@Url.Action("Index", "Products", new { area = "Admin" })">
                Quản lý sản phẩm
            </a>
        </div>

    </div>
</div>
