
@model Be_25dh110275_NguyenHoangAnh.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .delete-container {
        max-width: 650px;
        margin: 50px auto;
        font-family: Arial, sans-serif;
    }

    .delete-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .delete-header {
        background: #218b58;
        padding: 20px;
        color: white;
        font-size: 22px;
        font-weight: bold;
        text-align: center;
    }

    .delete-body {
        padding: 30px;
    }

    .delete-warning {
        background: #fff3cd;
        border-left: 5px solid #ffc107;
        border-radius: 5px;
        padding: 18px;
        color: #856404;
        margin-bottom: 25px;
    }

    .delete-info {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 25px;
    }

        .delete-info label {
            font-weight: bold;
            color: #555;
        }

        .delete-info h3 {
            color: #218b58;
            font-size: 22px;
            margin: 10px 0 0;
        }

    .delete-actions {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .delete-actions .btn {
            padding: 11px 22px;
            border-radius: 6px;
            font-weight: bold;
        }
</style>

<div class="delete-container">
    <div class="delete-card">

        <div class="delete-header">
            <i class="fas fa-trash-alt"></i>
            XÓA DANH MỤC
        </div>

        <div class="delete-body">

            <div class="delete-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Cảnh báo!</strong>
                <p style="margin:10px 0 0;">
                    Bạn có chắc chắn muốn xóa danh mục này?
                    Hành động này không thể hoàn tác.
                </p>
            </div>

            <div class="delete-info">
                <label>Tên danh mục:</label>
                <h3>@Html.DisplayFor(model => model.CategoryName)</h3>
            </div>

            @using (Html.BeginForm("Delete", "Categories",
                new { area = "Admin" }, FormMethod.Post,
                new { id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.CategoryID)

                <div class="delete-actions">

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Bạn chắc chắn muốn xóa danh mục này?');">
                        <i class="fas fa-trash"></i>
                        Xác nhận xóa
                    </button>

                    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })"
                       class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i>
                        Quay lại danh sách
                    </a>

                </div>
            }

        </div>
    </div>
</div>
