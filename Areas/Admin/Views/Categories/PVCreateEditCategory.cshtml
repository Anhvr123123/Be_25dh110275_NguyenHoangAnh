@model Be_25dh110275_NguyenHoangAnh.Models.Category

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-title {
        background-color: #1E8A54;
        color: #000000;
        padding: 10px 15px;
        font-weight: bold;
        font-size: 22px;
        width: 100%;
        margin-bottom: 20px;
        box-sizing: border-box;
    }
</style>

<div class="category-title">
    THÊM MỚI DANH MỤC
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label class="control-label col-md-2" style="font-weight: bold;">Tên danh mục</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục..." } })
                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <div class="col-md-offset-2 col-md-10" style="display: flex; gap: 10px;">
                <input type="submit" value="Thêm mới" class="btn btn-primary" />
                @Html.ActionLink("Trở về danh sách", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
}