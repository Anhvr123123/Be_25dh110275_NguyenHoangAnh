@model Be_25dh110275_NguyenHoangAnh.Models.Category

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-title-admin {
        background-color: #1E8A54 !important;
        color: #000000 !important;
        padding: 10px 15px;
        font-weight: bold;
        font-size: 22px;
        width: 100%;
        margin-bottom: 20px;
        box-sizing: border-box;
    }
</style>

<div class="page-title-admin">
    CHI TIẾT DANH MỤC
</div>

<div class="container-fluid" style="margin-top: 20px;">
    <div class="container-fluid" style="margin-top: 20px;">
        <div>
            <dl class="dl-horizontal">
                <dt>Mã danh mục:</dt>
                <dd>
                    @Html.TextBox("CategoryID", Model.CategoryID, new { @class = "form-control", @readonly = "readonly", style = "max-width: 300px;" })
                </dd>

                <dt style="font-weight: bold;">Tên danh mục:</dt>
                <dd>
                    @Html.TextBox("CategoryName", Model.CategoryName, new { @class = "form-control", @readonly = "readonly", style = "max-width: 300px;" })
                </dd>
            </dl>
        </div>

        <p style="margin-top: 20px; display: flex; gap: 10px;">
            @Html.ActionLink("CHỈNH SỬA", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("QUAY LẠI DANH SÁCH", "Index", null, new { @class = "btn btn-primary" })
        </p>
    </div>
</div>