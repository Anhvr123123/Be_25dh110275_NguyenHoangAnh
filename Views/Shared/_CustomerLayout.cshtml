@{
    // Lấy thông tin giỏ hàng từ Session
    var cart = Session["Cart"] as Be_25dh110275_NguyenHoangAnh.Models.ViewModel.Cart;

    // Khởi tạo ViewBag.pmmodel để kiểm tra trạng thái đăng nhập
    ViewBag.pmmodel = new Be_25dh110275_NguyenHoangAnh.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = User.Identity.IsAuthenticated,
        Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty,
        CartCount = (cart != null && cart.Items != null) ? cart.Items.Sum(i => i.Quantity) : 0
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My Store</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        /* CSS tùy chỉnh cho Menu cá nhân dạng Dropdown */
        .navbar-nav {
            list-style-type: none;
            padding: 0;
            margin: 0;
            display: flex;
            align-items: center;
        }

            .navbar-nav > li {
                margin-right: 20px;
                position: relative;
            }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
            z-index: 1000;
            border-radius: 4px;
        }

            .dropdown-content a {
                color: black;
                padding: 10px 16px;
                text-decoration: none;
                display: block;
            }

                .dropdown-content a:hover {
                    background-color: #f1f1f1;
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }
    </style>
</head>
<body>
    <div class="navbar navbar-default navbar-fixed-top bg-light shadow-sm">
        <!-- Thanh Banner Freeship -->
        <header class="container-fluid py-1" style="background-color: #e8f5e9;">
            <h6 style="text-align:center; color:#2e7d32; margin: 5px 0;">
                Free ship đơn từ 40k, giảm nhiều hơn cùng
                <span style="font-weight:bolder; font-style: italic;"><span style="color: blue;">FREESHIP</span> XTRA</span>
            </h6>
        </header>

        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse" title="more options">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <!-- Logo trang web -->
                <a href="@Url.Action("Index", "Home")" class="navbar-brand">
                    <span style="font-weight: bold; color: #1E8A54; font-size: 24px;">FASTOR</span>
                </a>
            </div>

            <div class="navbar-collapse collapse navbar-right">
                <ul class="nav navbar-nav">
                    <!-- Trang chủ -->
                    <li>
                        <div>
                            <i class="fas fa-home"></i>
                            @Html.ActionLink("Trang chủ", "Index", "Home", new { area = "" }, null)
                        </div>
                    </li>

                    <!-- Menu Tài khoản (Dropdown) -->
                    <li class="dropdown">
                        <div style="position:relative;">
                            <i class="fas fa-user"></i>
                            <a href="javascript:void(0)" id="account-name">
                                @if (ViewBag.pmmodel.IsLoggedIn)
                                {
                                    <text>Hello, </text>@ViewBag.pmmodel.Username
                                }
                                else
                                {
                                    <text>Tài khoản</text>
                                }
                            </a>
                            <div class="dropdown-content">
                                @if (ViewBag.pmmodel.IsLoggedIn)
                                {
                                    <a href="@Url.Action("Profile", "Account")">Thông tin tài khoản</a>
                                    <a href="@Url.Action("MyOrder", "Order")">Lịch sử mua hàng</a>
                                    <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                                }
                            </div>
                        </div>
                    </li>

                    <!-- Giỏ hàng kèm số lượng -->
                    <li>
                        <div>
                            <a href="@Url.Action("Index2", "Cart")" style="text-decoration: none;">
                                <i class="fas fa-shopping-cart"></i> Giỏ hàng
                                (<span id="cart-count" style="color: red; font-weight: bold;">@ViewBag.pmmodel.CartCount</span>)
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Nội dung chính của trang -->
    <div class="container body-content" style="margin-top: 80px;">
        @RenderBody()
        <hr />
        <footer class="text-center py-4">
            <p>&copy; @DateTime.Now.Year - My Store E-commerce</p>
            <p class="text-muted" style="font-size: 13px;">Contact: Tên các thành viên trong nhóm</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
