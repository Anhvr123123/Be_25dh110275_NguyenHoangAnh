@model Be_25dh110275_NguyenHoangAnh.Models.Product

@{
    ViewBag.Title = Model != null ? Model.ProductName : "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container my-4">
    @if (Model != null)
    {
        <!-- Breadcrumb điều hướng -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                @if (Model.Category != null)
                {
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("ProductList", "Home", new { categoryId = Model.CategoryID })">@Model.Category.CategoryName</a>
                    </li>
                }
                <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
            </ol>
        </nav>

        <!-- Chi tiết sản phẩm -->
        <div class="row bg-white p-4 rounded shadow-sm">
            <!-- Cột hình ảnh (Lấy link từ ngoài) -->
            <div class="col-md-5 text-center mb-3 mb-md-0">
                <img src="@Model.ProductImage"
                     class="img-fluid rounded shadow-sm border bg-light p-2 w-100"
                     alt="@Model.ProductName"
                     style="max-height: 400px; object-fit: contain;"
                     onerror="this.onerror=null;this.src='https://via.placeholder.com/400x400?text=No+Image';" />
            </div>

            <!-- Cột thông tin sản phẩm -->
            <div class="col-md-7">
                <h2 class="fw-bold mb-3">@Model.ProductName</h2>

                <p class="text-muted mb-2">
                    Danh mục: <span class="fw-semibold text-dark">@(Model.Category != null ? Model.Category.CategoryName : "Chưa phân loại")</span>
                </p>

                <h3 class="text-danger fw-bold mb-4">
                    @string.Format("{0:N0} đ", Model.ProductPrice)
                </h3>

                <div class="mb-4">
                    <h5 class="fw-bold">Mô tả sản phẩm:</h5>
                    <p class="text-secondary">@Model.ProductDecription</p>
                </div>

                <!-- Form Thêm vào giỏ hàng (Đã đồng bộ tên tham số là 'id') -->
                <form action="@Url.Action("AddToCart", "Cart")" method="get">
                    <input type="hidden" name="id" value="@Model.ProductID" />

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <label for="quantity" class="fw-bold mb-0">Số lượng:</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" class="form-control text-center" style="width: 90px;" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="fa fa-shopping-cart me-2"></i> Thêm vào giỏ hàng
                        </button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                            Tiếp tục mua sắm
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sản phẩm liên quan -->
        <div class="mt-5">
            <h4 class="fw-bold mb-3">Sản phẩm liên quan</h4>
            <div class="row">
                @if (ViewBag.RelatedProducts != null && ((List<Be_25dh110275_NguyenHoangAnh.Models.Product>)ViewBag.RelatedProducts).Any())
                {
                    foreach (var prod in ViewBag.RelatedProducts as List<Be_25dh110275_NguyenHoangAnh.Models.Product>)
                    {
                        <div class="col-md-3 mb-3">
                            <div class="card h-100 shadow-sm border-0">
                                <a href="@Url.Action("Details", "Home", new { id = prod.ProductID })">
                                    <img src="@prod.ProductImage" class="card-img-top bg-light" alt="@prod.ProductName" style="height: 180px; object-fit: contain;" onerror="this.onerror=null;this.src='https://via.placeholder.com/180x180?text=No+Image';" />
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title text-truncate">
                                        <a href="@Url.Action("Details", "Home", new { id = prod.ProductID })" class="text-decoration-none text-dark">@prod.ProductName</a>
                                    </h6>
                                    <p class="text-danger fw-bold mb-2">@string.Format("{0:N0} đ", prod.ProductPrice)</p>
                                    <a href="@Url.Action("Details", "Home", new { id = prod.ProductID })" class="btn btn-outline-primary btn-sm mt-auto">Xem chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Không có sản phẩm liên quan nào.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center">Không tìm thấy thông tin sản phẩm!</div>
    }
</div>