@model Be_25dh110275_NguyenHoangAnh.Models.Product

@{
    ViewBag.Title = Model.ProductName + " - MyStore";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-4">
    <!-- Đường dẫn breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#">@(Model.Category != null ? Model.Category.CategoryName : "Danh mục")</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <!-- Chi tiết sản phẩm -->
    <div class="row bg-white p-4 rounded shadow-sm">
        <div class="col-md-5">
            <img src="~/Content/images/@Model.ProductImage" class="img-fluid rounded border" alt="@Model.ProductName" style="width: 100%; max-height: 400px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/400'" />
        </div>
        <div class="col-md-7">
            <h2 class="font-weight-bold">@Model.ProductName</h2>
            <p class="text-muted">Danh mục: <span class="badge badge-info">@(Model.Category != null ? Model.Category.CategoryName : "Khác")</span></p>
            <h3 class="text-danger font-weight-bold mb-3">@string.Format("{0:N0} đ", Model.ProductPrice)</h3>

            <hr />

            <h5>Mô tả sản phẩm:</h5>
            <p class="text-secondary">@(string.IsNullOrEmpty(Model.ProductDecription) ? "Chưa có mô tả cho sản phẩm này." : Model.ProductDecription)</p>

            <div class="mt-4">
                <!-- Nút thêm vào giỏ hàng -->
                <a href="@Url.Action("AddToCart", "Cart", new { id = Model.ProductID })" class="btn btn-success btn-lg px-4 mr-2">
                    <i class="fa fa-shopping-cart"></i> Thêm vào giỏ hàng
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">Tiếp tục mua sắm</a>
            </div>
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    <div class="mt-5">
        <h4 class="border-bottom pb-2 mb-3"><i class="fa fa-cubes"></i> Sản phẩm liên quan</h4>
        <div class="row">
            @{
                var relatedList = ViewBag.RelatedProducts as List<Be_25dh110275_NguyenHoangAnh.Models.Product>;
            }
            @if (relatedList != null && relatedList.Any())
            {
                foreach (var item in relatedList)
                {
                    <div class="col-md-3 mb-3">
                        <div class="card h-100 shadow-sm">
                            <img src="~/Content/images/@item.ProductImage" class="card-img-top" style="height: 160px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/200'" />
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title">@item.ProductName</h6>
                                <p class="card-text text-danger font-weight-bold">@string.Format("{0:N0} đ", item.ProductPrice)</p>
                                <a href="@Url.Action("Details", "Home", new { id = item.ProductID })" class="btn btn-sm btn-outline-primary mt-auto">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Không có sản phẩm liên quan nào.</p>
            }
        </div>
    </div>
</div>