@model IEnumerable<Be_25dh110275_NguyenHoangAnh.Models.Order>

@{
    ViewBag.Title = "Lịch sử mua hàng - MyStore";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4 text-primary fw-bold"><i class="fa fa-history me-2"></i> Lịch Sử Mua Hàng</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center p-4 shadow-sm border-0">
            <h5><i class="fa fa-info-circle me-1"></i> Bạn chưa có đơn hàng nào!</h5>
            <p class="mb-3">Hãy tiếp tục mua sắm để khám phá thêm nhiều sản phẩm hấp dẫn.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary"><i class="fa fa-shopping-cart me-1"></i> Mua sắm ngay</a>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                    <div>
                        <span class="fw-bold fs-6">Mã đơn hàng: <strong class="text-primary">#@order.OrderID</strong></span>
                        <span class="text-muted ms-3">| Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div>
                        <span class="badge bg-success px-3 py-2">@order.PaymentStatus</span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Địa chỉ giao hàng:</strong> @order.ShippingAddress</p>

                    <table class="table table-hover mt-3 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (order.OrderDetails != null)
                            {
                                foreach (var item in order.OrderDetails)
                                {
                                    <tr>
                                        <td>@(item.Product != null ? item.Product.ProductName : "Sản phẩm")</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@string.Format("{0:N0} đ", item.UnitPrice)</td>
                                        <td class="text-end">@string.Format("{0:N0} đ", item.Quantity * item.UnitPrice)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted">Tổng cộng:</span>
                    <strong class="text-danger fs-5">@string.Format("{0:N0} đ", order.TotalAmount)</strong>
                </div>
            </div>
        }
    }
</div>