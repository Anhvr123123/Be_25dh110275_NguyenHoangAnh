@model IEnumerable<Be_25dh110275_NguyenHoangAnh.Models.Order>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="padding: 30px 0;">
    <h2>Đơn hàng của tôi</h2>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <p>Bạn chưa có đơn hàng nào.</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Phương thức thanh toán</th>
                    <th>Địa chỉ giao hàng</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.OrderID</td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span style="color: red; font-weight: bold;">@item.TotalAmount.ToString("N0") đ</span></td>
                        <td>@item.PaymentStatus</td>
                        <td>@item.AddressDelivery</td>
                        <td>
                            @Html.ActionLink("Xem chi tiết", "OrderSuccess", "Order", new { id = item.OrderID }, new { @class = "btn btn-info btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>