@model Be_25dh110275_NguyenHoangAnh.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="padding: 30px 0;">
    <h2>Chi tiết đơn hàng #@Model.OrderID</h2>
    <hr />

    <div class="panel panel-default">
        <div class="panel-heading"><strong>Thông tin đơn hàng</strong></div>
        <div class="panel-body">
            <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
            <p><strong>Tổng tiền:</strong> <span style="color: red; font-weight: bold;">@Model.TotalAmount.ToString("N0") đ</span></p>
        </div>
    </div>

    <h3>Danh sách sản phẩm</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Hình ảnh</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                <tr>
                    <td>@(detail.Product != null ? detail.Product.ProductName : "Sản phẩm không tồn tại")</td>
                    <td>
                        @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ProductImage))
                        {
                            <img src="@detail.Product.ProductImage" alt="" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                    </td>
                    <td>@detail.UnitPrice.ToString("N0") đ</td>
                    <td>@detail.Quantity</td>
                    <td>@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
    </table>

    <p>
        <a href="@Url.Action("MyOrder", "Order")" class="btn btn-default">Quay lại lịch sử đơn hàng</a>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Tiếp tục mua sắm</a>
    </p>
</div>