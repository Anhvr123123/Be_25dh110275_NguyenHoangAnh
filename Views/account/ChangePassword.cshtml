@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .change-password-container {
        max-width: 580px;
        margin: 40px auto 80px;
        padding: 32px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5e7eb;
    }

    .change-password-title {
        text-align: center;
        color: #087e42;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 28px;
    }

    .change-password-container .form-group {
        margin-bottom: 20px;
    }

    .change-password-container label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #333;
    }

    .change-password-container .form-control {
        width: 100%;
        height: 45px;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        font-size: 15px;
        box-sizing: border-box;
    }

        .change-password-container .form-control:focus {
            border-color: #087e42;
            outline: none;
            box-shadow: 0 0 0 3px rgba(8, 126, 66, 0.12);
        }

    .change-password-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

        .change-password-actions .btn {
            padding: 11px 18px;
            border-radius: 7px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
        }

        .change-password-actions .btn-success {
            background: #087e42;
            border: 1px solid #087e42;
            color: white;
        }

            .change-password-actions .btn-success:hover {
                background: #066b38;
                border-color: #066b38;
            }

        .change-password-actions .btn-outline-secondary {
            background: white;
            color: #475569;
            border: 1px solid #94a3b8;
        }

            .change-password-actions .btn-outline-secondary:hover {
                background: #f1f5f9;
            }

    .change-password-error {
        color: #dc3545;
        font-size: 14px;
        margin-top: 6px;
    }

    @@media (max-width: 480px) {
        .change-password-container {
            margin: 25px auto 50px;
            padding: 20px;
        }

        .change-password-title {
            font-size: 24px;
        }

        .change-password-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .change-password-actions .btn {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="change-password-container">

    <h2 class="change-password-title">
        🔒 ĐỔI MẬT KHẨU
    </h2>

    @if (ViewBag.Error != null)
    {
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
    }

    @if (TempData["Error"] != null)
    {
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
    }

    @Html.ValidationSummary(
    true,
    "",
    new { @class = "text-danger" }
    )

    @using (Html.BeginForm(
    "ChangePassword",
    "Account",
    FormMethod.Post,
    new
    {
    id = "changePasswordForm",
    autocomplete = "off"
    }))
    {
    @Html.AntiForgeryToken()

    <div class="form-group">

        <label for="oldPassword">
            Mật khẩu cũ
        </label>

        <input type="password"
               id="oldPassword"
               name="oldPassword"
               class="form-control"
               placeholder="Nhập mật khẩu hiện tại..."
               autocomplete="current-password"
               required />

    </div>

    <div class="form-group">

        <label for="newPassword">
            Mật khẩu mới
        </label>

        <input type="password"
               id="newPassword"
               name="newPassword"
               class="form-control"
               placeholder="Nhập mật khẩu mới..."
               autocomplete="new-password"
               minlength="6"
               required />

    </div>

    <div class="form-group">

        <label for="confirmPassword">
            Xác nhận mật khẩu mới
        </label>

        <input type="password"
               id="confirmPassword"
               name="confirmPassword"
               class="form-control"
               placeholder="Nhập lại mật khẩu mới..."
               autocomplete="new-password"
               minlength="6"
               required />

        <div id="passwordError"
             class="change-password-error"
             style="display:none;">
            Mật khẩu xác nhận không khớp.
        </div>

    </div>

    <div class="change-password-actions">

        @Html.ActionLink(
        "← Quay lại hồ sơ",
        "ProfileInfo",
        "Account",
        new { area = "" },
        new { @class = "btn btn-outline-secondary" }
        )

        <button type="submit"
                class="btn btn-success">
            🔒 Cập nhật mật khẩu
        </button>

    </div>
    }

</div>

<script>(function () {

        var form = document.getElementById(
            "changePasswordForm"
        );

        if (!form) return;

        form.addEventListener("submit", function (event) {

            var oldPassword =
                document.getElementById("oldPassword").value;

            var newPassword =
                document.getElementById("newPassword").value;

            var confirmPassword =
                document.getElementById("confirmPassword").value;

            var error =
                document.getElementById("passwordError");

            error.style.display = "none";

            if (newPassword.length < 6) {
                event.preventDefault();
                alert("Mật khẩu mới phải có ít nhất 6 ký tự.");
                return;
            }

            if (newPassword !== confirmPassword) {
                event.preventDefault();
                error.style.display = "block";
                return;
            }

            if (oldPassword === newPassword) {
                event.preventDefault();
                alert("Mật khẩu mới phải khác mật khẩu cũ.");
                return;
            }

        });

    })();</script>
