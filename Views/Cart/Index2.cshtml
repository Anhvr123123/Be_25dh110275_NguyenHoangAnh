@model Be_25dh110275_NguyenHoangAnh.Models.ViewModel.Cart
@using PagedList.Mvc;

@{
    ViewBag.Title = "Giỏ hàng của bạn - MyStore";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fa fa-shopping-cart"></i> Giỏ Hàng Của Bạn</h2>

    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th style="width: 140px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="~/Content/images/@item.ProductImage" style="width: 60px; height: 60px; object-fit: cover;" class="rounded" onerror="this.src='https://via.placeholder.com/60'" />
                            </td>
                            <td class="align-middle font-weight-bold">@item.ProductName</td>
                            <td class="align-middle text-danger">@string.Format("{0:N0} đ", item.UnitPrice)</td>
                            <td class="align-middle">
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                {
                                    @Html.Hidden("id", item.ProductID)
                                    <div class="input-group">
                                        <!-- Tự động submit form khi thay đổi số lượng -->
                                        <input type="number" name="quantity" value="@item.Quantity" min="1"
                                               class="form-control form-control-sm text-center"
                                               onchange="this.form.submit();" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cập nhật" style="display:none;"><i class="fa fa-refresh"></i></button>
                                    </div>
                                }
                            </td>
                            <td class="align-middle text-danger font-weight-bold">@string.Format("{0:N0} đ", item.TotalPrice)</td>
                            <td class="align-middle text-center">
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    <i class="fa fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 mb-5">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary"><i class="fa fa-arrow-left"></i> Tiếp tục mua sắm</a>
            <div>
                <h4 class="text-right mb-3">Tổng tiền thanh toán: <span class="text-danger font-weight-bold">@string.Format("{0:N0} đ", Model.TotalPrice())</span></h4>
                <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg px-5"><i class="fa fa-check-circle"></i> Tiến hành thanh toán</a>
            </div>
        </div>

        <!-- Phần sản phẩm gợi ý / liên quan kèm phân trang -->
        if (Model.SimilarProducts != null && Model.SimilarProducts.Any())
        {
            <hr />
            <h4 class="mt-4 mb-3"><i class="fa fa-cubes"></i> Sản phẩm gợi ý cho bạn</h4>
            <div class="row">
                @foreach (var prod in Model.SimilarProducts)
                {
                    <div class="col-md-3 mb-3">
                        <div class="card h-100 shadow-sm">
                            <img src="~/Content/images/@prod.ProductImage" class="card-img-top" style="height: 160px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/200'" />
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title">@prod.ProductName</h6>
                                <p class="card-text text-danger font-weight-bold">@string.Format("{0:N0} đ", prod.ProductPrice)</p>
                                <a href="@Url.Action("Details", "Home", new { id = prod.ProductID })" class="btn btn-sm btn-outline-primary mt-auto">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-center mt-3">
                @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index2", new { page }))
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 bg-light rounded">
            <h4 class="text-muted mb-3">Giỏ hàng của bạn đang trống!</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4">Khám phá sản phẩm ngay</a>
        </div>
    }
</div>