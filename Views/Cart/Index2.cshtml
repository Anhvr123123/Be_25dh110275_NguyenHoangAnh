
@model Be_25dh110275_NguyenHoangAnh.Models.ViewModel.Cart
@using System
@using System.Linq
@using PagedList.Mvc

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    string fallbackImage = Url.Content(
        "~/Content/images/no-image.png");
}

<style>
    .cart-page {
        max-width: 1150px;
        margin: 35px auto 70px;
    }

    .cart-title {
        color: #087e42;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .cart-table thead {
            background: #212529;
            color: white;
        }

        .cart-table th,
        .cart-table td {
            padding: 13px;
            border: 1px solid #e5e7eb;
            vertical-align: middle;
        }

        .cart-table th {
            white-space: nowrap;
        }

    .cart-product-image {
        width: 80px;
        height: 100px;
        object-fit: contain;
        border-radius: 8px;
        background: #f8f9fa;
    }

    .cart-product-name {
        font-weight: 600;
        color: #222;
    }

    .cart-price {
        color: #dc3545;
        font-weight: 700;
        white-space: nowrap;
    }

    .cart-quantity {
        width: 90px;
        text-align: center;
        margin: auto;
    }

    .cart-summary {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 30px;
        margin-bottom: 45px;
    }

    .cart-total {
        font-size: 23px;
        margin-bottom: 18px;
    }

    .cart-checkout {
        display: inline-block;
        padding: 13px 35px;
        background: #087e42;
        color: white !important;
        border-radius: 8px;
        text-decoration: none !important;
        font-size: 17px;
        font-weight: 700;
    }

        .cart-checkout:hover {
            background: #066b38;
        }

    .cart-suggested-title {
        font-size: 23px;
        font-weight: 700;
        color: #087e42;
        margin: 25px 0;
    }

    .cart-suggested-image {
        width: 100%;
        height: 190px;
        object-fit: contain;
        padding: 12px;
    }

    .cart-suggested-card {
        border-radius: 12px;
        overflow: hidden;
    }

    @@media (max-width: 768px) {
        .cart-page {
            margin-top: 20px;
        }

        .cart-title {
            font-size: 23px;
        }

        .cart-table {
            min-width: 700px;
        }

        .cart-summary {
            align-items: stretch;
        }

            .cart-summary > div {
                width: 100%;
            }

        .cart-total {
            font-size: 20px;
        }

        .cart-checkout {
            display: block;
            text-align: center;
        }
    }
</style>

<div class="cart-page">

    <h2 class="cart-title">
        🛒 GIỎ HÀNG CỦA BẠN
    </h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    @if (Model != null &&
         Model.Items != null &&
         Model.Items.Any())
    {
        <div class="table-responsive">

            <table class="cart-table">

                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        string imagePath =
                            Convert.ToString(item.ProductImage);

                        string imageUrl = fallbackImage;

                        if (!string.IsNullOrWhiteSpace(imagePath))
                        {
                            imagePath = imagePath.Trim();

                            if (imagePath.StartsWith(
                                "https://",
                                StringComparison.OrdinalIgnoreCase) ||
                                imagePath.StartsWith(
                                "http://",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                imageUrl = imagePath;
                            }
                            else if (imagePath.StartsWith("~/"))
                            {
                                imageUrl = Url.Content(imagePath);
                            }
                            else if (imagePath.StartsWith("/"))
                            {
                                imageUrl = Url.Content(
                                    "~" + imagePath);
                            }
                            else if (imagePath.Contains("/"))
                            {
                                imageUrl = Url.Content(
                                    "~/" + imagePath);
                            }
                            else
                            {
                                imageUrl = Url.Content(
                                    "~/Content/images/" + imagePath);
                            }
                        }

                        <tr>

                            <td class="text-center">

                                <img src="@imageUrl"
                                     alt="@item.ProductName"
                                     class="cart-product-image"
                                     onerror="this.onerror=null;this.src='@fallbackImage';" />

                            </td>

                            <td class="cart-product-name">
                                @item.ProductName
                            </td>

                            <td class="cart-price">
                                @string.Format(
                                         "{0:N0} đ",
                                         item.UnitPrice)
                            </td>

                            <td>

                                @using (Html.BeginForm(
                                    "UpdateQuantity",
                                    "Cart",
                                    FormMethod.Post))
                                {
                                    @Html.Hidden(
                                             "id",
                                             item.ProductID)

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           class="form-control cart-quantity"
                                           onchange="this.form.submit();" />
                                }

                            </td>

                            <td class="cart-price">
                                @string.Format(
                                         "{0:N0} đ",
                                         item.TotalPrice)
                            </td>

                            <td class="text-center">

                                <a href="@Url.Action(
                                    "RemoveFromCart",
                                    "Cart",
                                    new
                                    {
                                        area = "",
                                        id = item.ProductID
                                    })"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    Xóa
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>
            </table>

        </div>

        <div class="cart-summary">

            <a href="@Url.Action(
                "Index",
                "Home",
                new { area = "" })"
               class="btn btn-outline-primary">
                ← Tiếp tục mua sắm
            </a>

            <div>

                <h4 class="cart-total">
                    Tổng tiền thanh toán:
                    <span class="cart-price">
                        @string.Format(
                                 "{0:N0} đ",
                                 Model.TotalPrice())
                    </span>
                </h4>

                <a href="@Url.Action(
                    "Checkout",
                    "Order",
                    new { area = "" })"
                   class="cart-checkout">
                    ✓ Tiến hành thanh toán
                </a>

            </div>

        </div>

        if (Model.SimilarProducts != null &&
            Model.SimilarProducts.Any())
        {
            <hr />

            <h3 class="cart-suggested-title">
                📚 SẢN PHẨM GỢI Ý CHO BẠN
            </h3>

            <div class="row">

                @foreach (var prod in Model.SimilarProducts)
                {
                    string suggestedPath =
                        Convert.ToString(prod.ProductImage);

                    string suggestedUrl = fallbackImage;

                    if (!string.IsNullOrWhiteSpace(suggestedPath))
                    {
                        suggestedPath = suggestedPath.Trim();

                        if (suggestedPath.StartsWith(
                            "https://",
                            StringComparison.OrdinalIgnoreCase) ||
                            suggestedPath.StartsWith(
                            "http://",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            suggestedUrl = suggestedPath;
                        }
                        else if (suggestedPath.StartsWith("~/"))
                        {
                            suggestedUrl = Url.Content(suggestedPath);
                        }
                        else if (suggestedPath.StartsWith("/"))
                        {
                            suggestedUrl = Url.Content(
                                "~" + suggestedPath);
                        }
                        else if (suggestedPath.Contains("/"))
                        {
                            suggestedUrl = Url.Content(
                                "~/" + suggestedPath);
                        }
                        else
                        {
                            suggestedUrl = Url.Content(
                                "~/Content/images/" + suggestedPath);
                        }
                    }

                    <div class="col-md-3 col-sm-6 mb-4">

                        <div class="card h-100 shadow-sm cart-suggested-card">

                            <img src="@suggestedUrl"
                                 alt="@prod.ProductName"
                                 class="cart-suggested-image"
                                 onerror="this.onerror=null;this.src='@fallbackImage';" />

                            <div class="card-body d-flex flex-column">

                                <h6 class="card-title">
                                    @prod.ProductName
                                </h6>

                                <p class="cart-price">
                                    @string.Format(
                                             "{0:N0} đ",
                                             prod.ProductPrice)
                                </p>

                                <a href="@Url.Action(
                                    "Details",
                                    "Home",
                                    new
                                    {
                                        area = "",
                                        id = prod.ProductID
                                    })"
                                   class="btn btn-outline-success btn-sm mt-auto">
                                    Xem chi tiết
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <div class="d-flex justify-content-center mt-3">

                @Html.PagedListPager(
                         Model.SimilarProducts,
                         page => Url.Action(
                             "Index2",
                             "Cart",
                             new
                             {
                                 area = "",
                                 page = page
                             }))

            </div>
        }
    }
    else
    {
        <div class="text-center py-5 bg-light rounded">

            <h4 class="text-muted mb-3">
                Giỏ hàng của bạn đang trống!
            </h4>

            <p>
                Hãy khám phá những cuốn sách yêu thích
                tại ThegioiBook.
            </p>

            <a href="@Url.Action(
                "Index",
                "Home",
                new { area = "" })"
               class="btn btn-success">
                Khám phá sản phẩm ngay
            </a>

        </div>
    }

</div>
